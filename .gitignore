# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/

# Turborepo
.turbo/

# Environment (secrets — never commit)
.env
.env.local
.env.*.local
.env.production
.env.prod

# Firebase Android 클라이언트 설정 — CI 시크릿(GOOGLE_SERVICES_JSON) 또는 로컬 복사본.
# 자리표시는 apps/mobile/android/app/google-services.json.example 을 쓴다.
apps/mobile/android/app/google-services.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# 운영 논리 백업(DB 덤프·MinIO 객체). 민감 데이터이므로 절대 커밋하지 않는다.
backups/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.tsbuildinfo
.claude/scheduled_tasks.lock
.gstack/

# 배포 로그(로컬 진단용)
.deploy-logs/

# 작업 중 산출물 — 프로젝트 소스가 아니다.
# `git add -A`가 이것들을 통째로 쓸어 담아 225개가 인덱스에 들어간 적이 있다.
# 커밋됐다면 공개 저장소에 그대로 올라갔을 것이다.
tmp/
output/
.playwright-cli/

# Python 바이트코드(실행기 테스트·설치 때 생긴다)
__pycache__/
